{
  "schema_version": "0.1-refonte-j1",
  "project": "Double Vie",
  "purpose": "Source technique des variables et flags narratifs V2 pour la refonte du MVP/Jour 1.",
  "runtime_policy": {
    "variable_range": {
      "min": 0,
      "max": 100
    },
    "effects_are_relative": true,
    "clamp_after_effects": true,
    "flags_are_unique": true,
    "unknown_variables_policy": "warn_in_validation_before_runtime_integration",
    "legacy_effects_policy": "Preserve existing legacy variables until V2 runtime migration is complete. New J1 V2 content must use official_variables."
  },
  "official_variables": {
    "confiance_sarah": {
      "initial": 55,
      "min": 0,
      "max": 100,
      "description": "Mesure si Sarah peut croire que le joueur lui parle vraiment."
    },
    "distance_sarah": {
      "initial": 35,
      "min": 0,
      "max": 100,
      "description": "Mesure l’éloignement ressenti par Sarah."
    },
    "tension_camille": {
      "initial": 55,
      "min": 0,
      "max": 100,
      "description": "Mesure la charge affective et désirante avec Camille."
    },
    "respect_camille": {
      "initial": 50,
      "min": 0,
      "max": 100,
      "description": "Mesure si Camille se sent respectée et non utilisée."
    },
    "pression_camille": {
      "initial": 30,
      "min": 0,
      "max": 100,
      "description": "Mesure si Camille sent que le joueur pousse trop ou la transforme en refuge."
    },
    "intimite_sarah": {
      "initial": 45,
      "min": 0,
      "max": 100,
      "description": "Mesure la chaleur domestique et la présence réelle avec Sarah."
    },
    "intimite_camille": {
      "initial": 45,
      "min": 0,
      "max": 100,
      "description": "Mesure la proximité avec Camille au-delà du désir."
    },
    "attente_image_camille": {
      "initial": 0,
      "min": 0,
      "max": 100,
      "description": "Mesure l’attente, l’imaginaire et le fantasme autour d’une image possible de Camille."
    },
    "suspicion_maya": {
      "initial": 40,
      "min": 0,
      "max": 100,
      "description": "Mesure le niveau d’alerte sociale de Maya."
    },
    "dette_nico": {
      "initial": 20,
      "min": 0,
      "max": 100,
      "description": "Mesure le poids que le joueur fait porter à Nico."
    },
    "fuite_ines": {
      "initial": 10,
      "min": 0,
      "max": 100,
      "description": "Mesure la tentation de chercher une porte latérale auprès d’Inès."
    },
    "coherence": {
      "initial": 60,
      "min": 0,
      "max": 100,
      "description": "Mesure si les versions données par le joueur tiennent ensemble."
    },
    "culpabilite": {
      "initial": 35,
      "min": 0,
      "max": 100,
      "description": "Mesure la charge intérieure du joueur."
    },
    "risque_exposition": {
      "initial": 25,
      "min": 0,
      "max": 100,
      "description": "Mesure le risque que les traces, timings ou contradictions deviennent visibles."
    },
    "fatigue_emotionnelle": {
      "initial": 20,
      "min": 0,
      "max": 100,
      "description": "Mesure le coût psychique des mensonges, silences et tensions."
    }
  },
  "legacy_variable_mapping": {
    "sarah_trust": {
      "suggested_target": "confiance_sarah",
      "migration_note": "Mapping direct partiel. Ne pas appliquer mécaniquement sans relire le contexte."
    },
    "sarah_doubt": {
      "suggested_target": "distance_sarah",
      "migration_note": "Doute Sarah peut devenir distance_sarah ou perte de confiance selon la scène."
    },
    "camille_interest": {
      "suggested_target": "tension_camille",
      "migration_note": "Peut devenir tension_camille, intimite_camille ou respect_camille selon le sens du choix."
    },
    "risk": {
      "suggested_target": "risque_exposition",
      "migration_note": "Mapping quasi direct."
    },
    "guilt": {
      "suggested_target": "culpabilite",
      "migration_note": "Mapping quasi direct."
    },
    "nico_trust": {
      "suggested_target": "dette_nico",
      "migration_note": "Attention : dette_nico augmente quand Nico est utilisé, ce n’est pas une confiance positive."
    },
    "maya_trust": {
      "suggested_target": "suspicion_maya",
      "migration_note": "Mapping inversé ou contextuel."
    },
    "maya_interest": {
      "suggested_target": "suspicion_maya",
      "migration_note": "À relire : intérêt social peut augmenter suspicion_maya ou risque_exposition."
    },
    "ines_interest": {
      "suggested_target": "fuite_ines",
      "migration_note": "Ne pas traiter comme romance. Inès mesure surtout la fuite."
    },
    "player_presence": {
      "suggested_target": "coherence",
      "migration_note": "Peut aussi affecter intimite_sarah selon la scène."
    },
    "player_evasion": {
      "suggested_target": "fatigue_emotionnelle",
      "migration_note": "Peut aussi réduire coherence."
    }
  },
